generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  VIEWER
  ADMIN
  NORMAL_VIEWER
  VIP_VIEWER
}

enum AuditAction {
  USER_CREATED
  USER_PROFILE_UPDATED
  USER_ACCESS_CHANGED
  USER_DISABLED
  USER_ENABLED
  USER_PASSWORD_RESET
  USER_PASSWORD_CHANGED
  ACCOUNT_INVITE_CREATED
  ACCOUNT_SETUP_LINK_REGENERATED
  ACCOUNT_INVITE_CANCELLED
  ACCOUNT_SETUP_COMPLETED
  ACCOUNT_RESET_LOGIN_CREATED
  ACCOUNT_PASSWORD_RESET_COMPLETED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_MOVED
  CATEGORY_ARCHIVED
  CATEGORY_RESTORED
  CATEGORY_PURGED
  EXCEL_INSPECTED
  EXCEL_IMPORTED
  IMPORT_FAILED
  IMPORT_CANCELLED
  DATA_CREATED
  DATA_UPDATED
  DATA_ARCHIVED
  DATA_RESTORED
  DATA_COLLECTION_ARCHIVED
  DATA_COLLECTION_RESTORED
  DATA_COLLECTION_PURGED
  DOCUMENT_UPLOADED
  DOCUMENT_UPDATED
  DOCUMENT_ARCHIVED
  DOCUMENT_RESTORED
  DOCUMENT_PURGED
  DASHBOARD_WIDGET_CREATED
  DASHBOARD_WIDGET_UPDATED
  DASHBOARD_WIDGET_ARCHIVED
  REPORT_EXPORTED
}

enum AccessLevel {
  V1
  V2
  V3
  V4
  NORMAL
  VIP
  ADMIN
}

enum Clearance {
  V1
  V2
  V3
  V4
}

enum DataFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  ENUM
}

enum DataSourceType {
  EXCEL
  MANUAL
}

enum ImportStatus {
  PENDING
  INSPECTED
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

enum ChartType {
  KPI
  PIE
  BAR
  LINE
  CATEGORY_SUMMARY
}

enum AggregationType {
  COUNT
  SUM
  AVG
  MIN
  MAX
}

enum TimeGrouping {
  DAY
  MONTH
  QUARTER
  YEAR
}

model User {
  id                 String                      @id @default(cuid())
  email              String                      @unique
  name               String
  passwordHash       String
  role               UserRole                    @default(VIEWER)
  clearance          Clearance?
  permissionVersion  Int                         @default(0)
  isActive           Boolean                     @default(true)
  isPrimaryAdmin     Boolean                     @default(false)
  loginResetRequired Boolean                     @default(false)
  mustChangePassword Boolean                     @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  refreshTokens      RefreshToken[]
  categories         Category[]                  @relation("CategoryCreator")
  categoriesUpdated  Category[]                  @relation("CategoryUpdater")
  dataCollections    DataCollection[]            @relation("DataCollectionCreator")
  collectionsUpdated DataCollection[]            @relation("DataCollectionUpdater")
  dataRecords        DataRecord[]                @relation("DataRecordCreator")
  recordsUpdated     DataRecord[]                @relation("DataRecordUpdater")
  documents          Document[]                  @relation("DocumentCreator")
  documentsUpdated   Document[]                  @relation("DocumentUpdater")
  auditLogs          AuditLog[]
  importJobs         ImportJob[]
  dashboardWidgets   DashboardWidget[]           @relation("DashboardWidgetCreator")
  widgetsUpdated     DashboardWidget[]           @relation("DashboardWidgetUpdater")
  accountInvites     AccountInvite[]             @relation("AccountInviteCreator")
  resetTokens        AccountPasswordResetToken[] @relation("ResetTokenUser")
  resetTokensCreated AccountPasswordResetToken[] @relation("ResetTokenCreator")
  notificationReads NotificationRead[]

  @@index([role, isActive])
  @@index([clearance, isActive])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AccountInvite {
  id          String    @id @default(cuid())
  email       String
  name        String
  role        UserRole  @default(VIEWER)
  clearance   Clearance?
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String
  createdBy   User      @relation("AccountInviteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email, acceptedAt, revokedAt, expiresAt])
  @@index([createdById, createdAt])
}

model AccountPasswordResetToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation("ResetTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("ResetTokenCreator", fields: [createdById], references: [id], onDelete: Restrict)
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, usedAt, revokedAt, expiresAt])
  @@index([createdById, createdAt])
}

model Category {
  mainSlot        Int?             @unique
  accessLevel     AccessLevel?     @default(V4)
  id              String           @id @default(cuid())
  name            String
  description     String?
  sortOrder       Int              @default(0)
  parentId        String?
  parent          Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]       @relation("CategoryHierarchy")
  archivedAt      DateTime?
  createdById     String?
  createdBy       User?            @relation("CategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?            @relation("CategoryUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  dataRecords     DataRecord[]
  dataCollections DataCollection[]
  documents       Document[]
  ImportJob       ImportJob[]

  @@unique([parentId, name])
  @@index([parentId, archivedAt, sortOrder])
  @@index([archivedAt, name])
  @@index([accessLevel, archivedAt])
}

model DataCollection {
  id                 String            @id @default(cuid())
  categoryId         String
  category           Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name               String
  description        String?
  defaultAccessLevel AccessLevel       @default(V4)
  archivedAt         DateTime?
  createdById        String?
  createdBy          User?             @relation("DataCollectionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?
  updatedBy          User?             @relation("DataCollectionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  fields             DataField[]
  records            DataRecord[]
  importJobs         ImportJob[]
  dashboardWidgets   DashboardWidget[]

  @@unique([categoryId, name])
  @@index([categoryId, archivedAt])
}

model DataField {
  id               String            @id @default(cuid())
  dataCollectionId String
  dataCollection   DataCollection    @relation(fields: [dataCollectionId], references: [id], onDelete: Cascade)
  key              String
  label            String
  type             DataFieldType
  position         Int
  required         Boolean           @default(false)
  options          Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  dimensionWidgets DashboardWidget[] @relation("WidgetDimension")
  measureWidgets   DashboardWidget[] @relation("WidgetMeasure")

  @@unique([dataCollectionId, key])
  @@index([dataCollectionId, position])
}

model DashboardWidget {
  id               String          @id @default(cuid())
  title            String
  dataCollectionId String
  dataCollection   DataCollection  @relation(fields: [dataCollectionId], references: [id], onDelete: Restrict)
  chartType        ChartType
  dimensionFieldId String?
  dimensionField   DataField?      @relation("WidgetDimension", fields: [dimensionFieldId], references: [id], onDelete: Restrict)
  measureFieldId   String?
  measureField     DataField?      @relation("WidgetMeasure", fields: [measureFieldId], references: [id], onDelete: Restrict)
  aggregation      AggregationType
  timeGrouping     TimeGrouping?
  savedFilters     Json?
  accessLevel      AccessLevel     @default(V4)
  sortOrder        Int             @default(0)
  isActive         Boolean         @default(true)
  archivedAt       DateTime?
  createdById      String?
  createdBy        User?           @relation("DashboardWidgetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?           @relation("DashboardWidgetUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([accessLevel, isActive, archivedAt, sortOrder])
  @@index([dataCollectionId, archivedAt])
}

model DataRecord {
  id               String         @id @default(cuid())
  title            String
  payload          Json
  dataCollectionId String
  dataCollection   DataCollection @relation(fields: [dataCollectionId], references: [id], onDelete: Restrict)
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  accessLevel      AccessLevel    @default(V4)
  sourceType       DataSourceType @default(MANUAL)
  sourceImportId   String?
  sourceImport     ImportJob?     @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?          @relation("DataRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?          @relation("DataRecordUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([categoryId, archivedAt])
  @@index([dataCollectionId, archivedAt, createdAt])
  @@index([accessLevel, archivedAt])
  @@index([sourceImportId])
}

model ImportJob {
  accessLevel      AccessLevel?
  operationKey     String?         @unique
  id               String          @id @default(cuid())
  originalFileName String
  storageKey       String          @unique
  mimeType         String
  fileSize         Int
  status           ImportStatus    @default(PENDING)
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  dataCollectionId String?
  dataCollection   DataCollection? @relation(fields: [dataCollectionId], references: [id], onDelete: Restrict)
  sheetName        String?
  headerRow        Int?
  inspection       Json?
  totalRows        Int             @default(0)
  validRows        Int             @default(0)
  invalidRows      Int             @default(0)
  failureReason    String?
  createdById      String?
  createdBy        User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  completedAt      DateTime?
  records          DataRecord[]

  @@index([categoryId, status, createdAt])
  @@index([dataCollectionId, createdAt])
}

model Document {
  operationKey String?     @unique
  id          String      @id @default(cuid())
  title       String
  description String?
  fileName    String
  mimeType    String
  fileSize    Int
  storageKey  String      @unique
  accessLevel AccessLevel @default(V4)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdById String?
  createdBy   User?       @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?       @relation("DocumentUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  archivedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId, archivedAt])
  @@index([accessLevel, archivedAt, createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String
  entityId   String
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, createdAt])
}

model Notification {
  id          String   @id @default(cuid())
  operationKey String  @unique
  kind        String
  targetId    String
  createdAt   DateTime @default(now())
  reads       NotificationRead[]

  @@index([createdAt, id])
}

model NotificationRead {
  notificationId String
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt DateTime?

  @@id([notificationId, userId])
  @@index([userId, readAt])
}
